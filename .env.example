# Copia in .env (per test locale) o imposta come GitHub Actions secrets.

# --- Supabase (progetto pratomimuovo-traffico) ---
SUPABASE_URL=https://pfzfegfaagzeupopqaqj.supabase.co
# service_role key: Dashboard Supabase > Project Settings > API > service_role
# NON committarla, NON usarla lato client.
SUPABASE_SERVICE_KEY=

# --- Telegram ---
# Token del bot creato con @BotFather
TELEGRAM_BOT_TOKEN=
# ID del canale: @nomecanale (se pubblico) oppure -100xxxxxxxxxx (se privato)
TELEGRAM_CHAT_ID=

# --- Parametri allerta (opzionali) ---
RATEO_RAPIDO_M=0.15
NOTIFICA_RIENTRO=true
